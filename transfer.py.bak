
import csv
import json
import re
import subprocess
import sys
import time
import unicodedata

from pathlib import Path
from difflib import SequenceMatcher

ROOT = Path.home() / "MusicTransfer"
CLI = ROOT / "applemusic-agent-skill/scripts/applemusic_library.py"
SOURCE = ROOT / "yandex_liked.csv"
STATE = ROOT / "transfer_state.json"
REPORT = ROOT / "transfer_report.csv"

BATCH_SIZE = 20
MIN_SCORE = 0.76


def normalize(value):
    value = unicodedata.normalize("NFKD", value or "")
    value = "".join(c for c in value if not unicodedata.combining(c))
    value = value.lower()
    return re.sub(r"[^a-zа-яё0-9]+", " ", value).strip()


def similarity(a, b):
    return SequenceMatcher(
        None, normalize(a), normalize(b)
    ).ratio()


def load_state():
    if STATE.exists():
        return json.loads(STATE.read_text(encoding="utf-8"))

    return {
        "processed": [],
        "pending": [],
        "added": [],
        "report": []
    }


def save_state():
    STATE.write_text(
        json.dumps(state, ensure_ascii=False, indent=2),
        encoding="utf-8"
    )


def run_cli(args):
    result = subprocess.run(
        [sys.executable, str(CLI), *args],
        capture_output=True,
        text=True,
        timeout=90
    )

    if result.returncode != 0:
        raise RuntimeError(result.stderr or result.stdout)

    return json.loads(result.stdout)


def find_track(track):
    query = f"{track['Artist']} {track['Title']}"

    data = run_cli([
        "search", "--json", "--limit", "10",
        "--types", "songs", query
    ])

    songs = data.get("results", {}).get("songs", [])

    if not songs:
        return None

    candidates = []

    for song in songs:
        title_score = similarity(track["Title"], song["name"])
        artist_score = similarity(track["Artist"], song["artistName"])

        # Учитываем, если один исполнитель входит в список другого.
        a = normalize(track["Artist"])
        b = normalize(song["artistName"])

        if a and b and (a in b or b in a):
            artist_score = max(artist_score, 0.9)

        score = title_score * 0.7 + artist_score * 0.3

        if title_score >= 0.82 and score >= MIN_SCORE:
            candidates.append((score, song))

    if not candidates:
        return None

    candidates.sort(key=lambda x: x[0], reverse=True)
    return candidates[0][1]


def flush_pending():
    pending = state["pending"]

    if not pending:
        return True

    ids = list(dict.fromkeys(pending))

    print(f"\nДобавляем пачку: {len(ids)} треков")

    try:
        result = run_cli(["add", "--json", *ids])

        if not result.get("ok"):
            print("Apple Music вернул ошибку:", result)
            return False

        state["added"].extend(ids)
        state["pending"] = []
        save_state()

        print(f"Успешно отправлено: {len(ids)}")
        return True

    except Exception as error:
        print("Ошибка добавления:", error)
        print("Пачка сохранена для повторного запуска.")
        return False


def save_report():
    with open(REPORT, "w", encoding="utf-8-sig", newline="") as file:
        writer = csv.DictWriter(
            file,
            fieldnames=[
                "Title", "Artist", "Status",
                "Apple Track", "Apple Artist", "Apple ID"
            ]
        )
        writer.writeheader()
        writer.writerows(state["report"])


if not SOURCE.exists():
    raise FileNotFoundError(f"Не найден файл: {SOURCE}")

state = load_state()

with open(SOURCE, encoding="utf-8-sig") as file:
    tracks = list(csv.DictReader(file))

print(f"Всего песен: {len(tracks)}")
print(f"Уже обработано: {len(state['processed'])}")
print(f"Уже добавлено: {len(state['added'])}")

# Сначала повторяем незавершённую пачку, если она осталась.
if not flush_pending():
    sys.exit(1)

added_set = set(state["added"])
processed_set = set(state["processed"])

for index, track in enumerate(tracks):
    if index in processed_set:
        continue

    title = track["Title"]
    artist = track["Artist"]

    print(f"\n[{index + 1}/{len(tracks)}] {artist} — {title}")

    try:
        match = find_track(track)

        if match:
            apple_id = match["id"]

            if apple_id in added_set:
                status = "already_added"
            else:
                state["pending"].append(apple_id)
                added_set.add(apple_id)
                status = "matched"

            print(
                f"Найдено: {match['artistName']} — "
                f"{match['name']}"
            )

            state["report"].append({
                "Title": title,
                "Artist": artist,
                "Status": status,
                "Apple Track": match["name"],
                "Apple Artist": match["artistName"],
                "Apple ID": apple_id
            })

        else:
            print("Не найдено")

            state["report"].append({
                "Title": title,
                "Artist": artist,
                "Status": "not_found",
                "Apple Track": "",
                "Apple Artist": "",
                "Apple ID": ""
            })

        state["processed"].append(index)
        save_state()

        if len(state["pending"]) >= BATCH_SIZE:
            if not flush_pending():
                save_report()
                sys.exit(1)

        save_report()
        time.sleep(0.25)

    except Exception as error:
        print("Ошибка поиска:", error)

        state["report"].append({
            "Title": title,
            "Artist": artist,
            "Status": f"error: {error}",
            "Apple Track": "",
            "Apple Artist": "",
            "Apple ID": ""
        })

        state["processed"].append(index)
        save_state()
        save_report()

# Добавляем последнюю неполную пачку.
if not flush_pending():
    save_report()
    sys.exit(1)

save_report()

print("\n========== ГОТОВО ==========")
print("Обработано:", len(state["processed"]))
print("Добавлено:", len(state["added"]))
print("Отчёт:", REPORT)
